# ── Server ───────────────────────────────────────────────────────────────────
PORT=5002
NODE_ENV=development
# SeloraX dashboard URL (for redirects after payment)
DASHBOARD_URL=http://localhost:3000

# ── SeloraX platform (OAuth client credentials, Shopify-app style) ───────────
# All outbound platform calls send X-Client-Id + X-Client-Secret + X-Store-Id.
# No per-store access tokens are stored locally.
SELORAX_API_URL=http://localhost:5001/api
SELORAX_CLIENT_ID=
SELORAX_CLIENT_SECRET=
# Numeric app id — used to look up per-store webhook signing secrets from the
# platform's app_webhook_subscriptions table (models/messaging.js).
SELORAX_APP_ID=
# App embed slug used when building payment return URLs. Defaults to
# 'selorax-messaging' if unset (models/messaging-payment.js).
SELORAX_APP_SLUG=selorax-messaging

# ── Auth ─────────────────────────────────────────────────────────────────────
# Legacy x-auth-token JWT verification (backwards compatibility).
JWT_SECRET=your_selorax_jwt_secret
# Optional. When set, X-Session-Token JWTs are verified locally with HS256
# instead of round-tripping to the platform — the fast auth path. Also enables
# the HMAC check on /oauth/token and /oauth/revoke.
SESSION_SIGNING_KEY=
# FALLBACK ONLY. Webhook signatures are verified against the per-store secret in
# app_messaging_settings.webhook_signing_secret, which is generated on install.
# Prefer leaving this blank.
WEBHOOK_SIGNING_SECRET=
# Shared secret guarding /api/messaging/internal/* (platform-to-platform calls,
# e.g. the merchant "Send SMS" button). Set the same value on SeloraX-Backend as
# MESSAGING_INTERNAL_SECRET. Unset => /internal refuses every call with a 503.
INTERNAL_API_SECRET=
# Admin panel (/admin) — signs the sms_admin_token login cookie. Use a strong,
# random value distinct from JWT_SECRET. Falls back to JWT_SECRET if unset.
SMS_ADMIN_JWT_SECRET=change_me_to_a_long_random_string

# ── MySQL (same DB as SeloraX) ───────────────────────────────────────────────
MYSQL_HOST=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_PORT=3306
# Schema name of the SeloraX platform database. Read directly for the campaign
# audience `users` fallback, admin store-name lookups, and platform webhook
# signing secrets. Defaults to 'selorax_dev' where unset.
PLATFORM_DATABASE=selorax_dev

# ── SMS sending (SeloraX Messages platform) ──────────────────────────────────
# Every SMS goes through the SeloraX Messages platform as a PARTNER. Sender IDs
# and gateways are chosen per store in that platform's /admin, not here.
# Base URL without a trailing slash, e.g. https://smsapi.selorax.io
MESSAGING_PLATFORM_URL=
# The partner organization's API key (sx_…), from the platform.
MESSAGING_PLATFORM_API_KEY=

# ── Dev only (both required; ignored unless NODE_ENV=development) ────────────
# Skips authentication entirely. Never set these in production.
DEV_BYPASS_AUTH=false
DEV_STORE_ID=2

# ── Unused — kept for reference only ─────────────────────────────────────────
# No source file reads any of the following. Payments go through the platform
# billing API (services/platform-billing.js), not EPS directly. Listed so a
# deployed .env that still carries them is not mistaken for misconfiguration.
# APP_BASE_URL=http://localhost:5002
# EPS_BASE_URL=https://pgapi.eps.com.bd
# EPS_PG_URL=https://pg.eps.com.bd
# EPS_MERCHANT_ID=
# EPS_STORE_ID=
# EPS_USERNAME=
# EPS_PASSWORD=
# EPS_HASH_KEY=
